# Core authentication
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional dedicated HMAC secret for signed partner-attribution cookies.
# Use at least 32 random characters. Falls back to AUTH_SECRET/NEXTAUTH_SECRET.
PARTNER_ATTRIBUTION_SECRET=

# Days an order commission remains on HOLD after delivery before approval.
# Defaults to 7; accepted range is 0-365.
PARTNER_COMMISSION_RETURN_WINDOW_DAYS=7

# Dedicated encryption secret for partner bank/mobile-wallet account numbers.
# Use a random value with at least 32 characters, a 64-character hex key, or a 32-byte base64 key.
# Never rotate this value without a controlled payout-account re-encryption migration.
PARTNER_PAYOUT_ENCRYPTION_KEY=

# Database
DATABASE_URL=

# Production file storage (Vercel Blob)
BLOB_READ_WRITE_TOKEN=

# Production distributed rate limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Protected scheduled jobs
CRON_SECRET=

# Storefront search. PostgreSQL is the safe default and needs no extra service.
# Set SEARCH_PROVIDER=typesense only after all Typesense values are configured.
SEARCH_PROVIDER=postgresql
TYPESENSE_HOST=
TYPESENSE_ADMIN_API_KEY=
TYPESENSE_COLLECTION=storefront_products
SEARCH_INDEX_BATCH_SIZE=100

# Optional mailbox verification provider
MAILBOX_API_KEY=

# Contact form email delivery (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Optional override for business-portal invitation messages
BUSINESS_INVITATION_FROM_EMAIL=
# Comma-separated support inboxes; falls back to the public site contact email
CONTACT_RECIPIENT_EMAILS=
