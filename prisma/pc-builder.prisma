// PC Builder tables are created by the existing hand-written migrations.
// They are marked external in prisma.config.ts so Prisma Client can model them
// without future Prisma migrations attempting to recreate or drop them.

model PcBuildCartItem {
  cartItemId Int      @id
  buildId    String   @db.VarChar(64)
  slot       String   @db.VarChar(32)
  createdAt  DateTime @default(now())

  @@unique([buildId, slot])
  @@index([buildId])
}

model PcBuildOrderItem {
  orderItemId Int      @id
  orderId     Int
  buildId     String   @db.VarChar(64)
  slot        String   @db.VarChar(32)
  createdAt   DateTime @default(now())

  @@unique([buildId, slot])
  @@index([orderId, buildId])
}

model PcBuilderSavedBuild {
  id            String   @id @db.VarChar(64)
  userId        String
  name          String   @db.VarChar(80)
  shareToken    String   @unique @db.VarChar(64)
  selectionHash String   @db.Char(64)
  selections    Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())

  @@unique([userId, selectionHash])
  @@index([userId, updatedAt(sort: Desc)])
}
