{
  "name": "e-commerce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "cross-env USERPROFILE=C:\\temp next build --webpack",
    "build:prod": "cross-env USERPROFILE=C:\\temp NODE_ENV=production next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:phase0": "tsx --test tests/phase0-security.test.mjs",
    "test:phase1": "tsx --test tests/phase1-storefront.test.mjs",
    "test:phase2": "tsx --test tests/phase2-product-detail.test.mjs",
    "test:flash-sale": "tsx --test tests/flash-sale.test.mjs",
    "test:theme": "node tests/theme-contract.test.mjs",
    "test:storefront-cleanup": "node tests/storefront-tech-cleanup.test.mjs",
    "test:header-navigation": "node tests/header-navigation.test.mjs",
    "test:pc-builder": "tsx --test tests/pc-builder.test.mjs",
    "test:search": "tsx --test tests/search.test.mjs",
    "test:business-network-m1": "tsx --test tests/business-network-organization-core.test.mjs",
    "test:business-network-m2": "tsx --test tests/business-network-m2-schema.test.mjs tests/business-network-membership-rbac.test.ts tests/business-network-invitations.test.ts",
    "test:business-network-m3": "tsx --test tests/business-network-m3-schema.test.mjs tests/business-network-pricing.test.ts",
    "test:business-network-m4": "tsx --test tests/business-network-m4-schema.test.mjs tests/business-network-credit.test.ts",
    "test:business-network-m5": "tsx --test tests/business-network-m5-schema.test.mjs tests/business-network-sales-rfq.test.ts",
    "test:business-network-m6": "tsx --test tests/business-network-m6-schema.test.mjs tests/business-network-sales-quotation.test.ts",
    "test:business-network-m7": "tsx --test tests/business-network-m7-schema.test.mjs tests/business-network-customer-po.test.ts",
    "test:business-network-m8": "tsx --test tests/business-network-m8-schema.test.mjs tests/business-network-partner.test.ts",
    "test:business-network-m9": "tsx --test tests/business-network-m9-schema.test.mjs tests/business-network-partner-referral.test.ts",
    "test:business-network-m10": "tsx --test tests/business-network-m10-schema.test.mjs tests/business-network-commission.test.ts",
    "test:business-network-m11": "tsx --test tests/business-network-m11-schema.test.mjs tests/business-network-settlement.test.ts",
    "test:business-network-m12": "tsx --test tests/business-network-m12-portal.test.mjs tests/business-network-m12-navigation.test.ts",
    "test:business-network-m13": "tsx --test tests/business-network-m13-admin.test.mjs",
    "test:business-network-m14": "tsx --test tests/business-network-m14-governance.test.mjs",
    "test:business-network-m15-reporting": "tsx --test tests/business-network-m15-reporting.test.mjs",
    "test:business-network-m15-integration": "tsx --test tests/integration/business-network-m15.integration.test.mjs",
    "test:business-network-m15-security": "tsx --test tests/business-network-m15-security.test.mjs",
    "test:business-network-m15": "npm run test:business-network-m15-reporting && npm run test:business-network-m15-integration && npm run test:business-network-m15-security",
    "test:business-network-m1-to-m15": "npm run test:business-network-m1 && npm run test:business-network-m2 && npm run test:business-network-m3 && npm run test:business-network-m4 && npm run test:business-network-m5 && npm run test:business-network-m6 && npm run test:business-network-m7 && npm run test:business-network-m8 && npm run test:business-network-m9 && npm run test:business-network-m10 && npm run test:business-network-m11 && npm run test:business-network-m12 && npm run test:business-network-m13 && npm run test:business-network-m14 && npm run test:business-network-m15",
    "test:product-security": "tsx --test --test-name-pattern=\"storefront product projection|upload validation rejects|protected uploads\" tests/phase0-security.test.mjs",
    "test:products": "npm run test:product-security && npm run test:phase1 && npm run test:phase2 && npm run test:flash-sale && npm run test:storefront-cleanup && npm run test:header-navigation && npm run test:pc-builder && npm run test:search",
    "test:phases": "npm run test:phase0 && npm run test:phase1 && npm run test:phase2",
    "verify:products": "npm run test:products && npm run lint && npm run typecheck",
    "verify:phases": "npm run test:phases && npm run lint && npm run typecheck",
    "verify:business-network-m15": "npm run test:business-network-m15 && npm run lint && npm run typecheck && npx prisma validate",
    "verify:business-network-database": "npx prisma validate && npx prisma migrate status && npm run verify:business-organization-db && npm run verify:business-credit-db && npm run verify:sales-rfq-db && npm run verify:sales-quotation-db && npm run verify:customer-po-db && npm run verify:partner-agreement-db && npm run verify:partner-referral-db && npm run verify:commission-db && npm run verify:partner-settlement-db",
    "verify:business-network-m1-to-m15": "npm run test:business-network-m1-to-m15 && npm run verify:business-network-database && npm run lint && npm run typecheck",
    "verify:business-network-release": "npm run verify:business-network-m1-to-m15 && npm run build:prod",
    "seed:storefront": "tsx prisma/seed-storefront.ts",
    "seed:laptops": "tsx prisma/laptop-seed.ts",
    "seed:pc-builder": "node --no-warnings --experimental-strip-types scripts/seed-pc-builder.mjs",
    "repair:pc-builder-db": "node scripts/repair-pc-builder-database.mjs",
    "verify:pc-builder-db": "node scripts/verify-pc-builder-database.mjs",
    "verify:business-organization-db": "node scripts/verify-business-organization-database.mjs",
    "verify:business-credit-db": "node scripts/verify-business-credit-database.mjs",
    "verify:sales-rfq-db": "node scripts/verify-sales-rfq-database.mjs",
    "verify:sales-quotation-db": "node scripts/verify-sales-quotation-database.mjs",
    "verify:customer-po-db": "node scripts/verify-customer-po-database.mjs",
    "verify:partner-agreement-db": "node scripts/verify-partner-agreement-database.mjs",
    "verify:partner-referral-db": "node scripts/verify-partner-referral-database.mjs",
    "verify:commission-db": "node scripts/verify-commission-database.mjs",
    "verify:partner-settlement-db": "node scripts/verify-partner-settlement-database.mjs",
    "seed:storefront-menu": "tsx prisma/seed-storefront-menu.ts",
    "seed:flash-sales": "node scripts/seed-flash-sales.mjs",
    "email": "email dev",
    "cron:sla:trigger": "node scripts/cron/trigger-sla-eval.mjs",
    "postinstall": "prisma generate && copyfiles node_modules/pdfjs-dist/build/pdf.worker.min.js public"
  },
